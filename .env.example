# LLM API — any OpenAI-compatible endpoint
# Examples:
#   OpenAI:     REPOMATE_LLM_API_KEY=sk-xxx  REPOMATE_LLM_BASE_URL=https://api.openai.com/v1
#   Together:   REPOMATE_LLM_API_KEY=xxx     REPOMATE_LLM_BASE_URL=https://api.together.xyz/v1
#   Ollama:     REPOMATE_LLM_API_KEY=ollama  REPOMATE_LLM_BASE_URL=http://localhost:11434/v1
#   vLLM:       REPOMATE_LLM_API_KEY=local   REPOMATE_LLM_BASE_URL=http://localhost:8000/v1
REPOMATE_LLM_API_KEY=
REPOMATE_LLM_BASE_URL=https://api.openai.com/v1
REPOMATE_LLM_MODEL=gpt-4o-mini

# Model to fine-tune (any HuggingFace model)
REPOMATE_BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Embedding model
REPOMATE_BGE_MODEL_ID=BAAI/bge-small-en-v1.5
REPOMATE_RERANKER_MODEL_ID=BAAI/bge-reranker-base

# Device — auto-detected if empty (cuda, mps, cpu)
REPOMATE_DEVICE=
REPOMATE_DATA_DIR=
REPOMATE_VLLM_PORT=8000
REPOMATE_API_PORT=8080
REPOMATE_CHUNK_MAX_TOKENS=1024
REPOMATE_CHUNK_OVERLAP=128
REPOMATE_SYNTH_PAIRS_PER_CHUNK=3
REPOMATE_LOG_LEVEL=INFO
